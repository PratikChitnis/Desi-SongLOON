# Desi SongLOON — environment variables (copy this file to .env.local on the host)

# Public origin of the site, WITHOUT a trailing slash.
# Used for absolute og:image / link-preview URLs. MUST be set before `npm run build`
# (it is inlined into the client bundle at build time).
NEXT_PUBLIC_SITE_URL=https://yourdomain.example

# --- YouTube Data API ---
# Primary API key (Google Cloud Console > APIs > YouTube Data API v3 > Credentials).
YOUTUBE_API_KEY=
# Optional second key used automatically when the primary is rate-limited (429).
YOUTUBE_API_KEY_FALLBACK=
# The station's public playlist id (the curated 90s Bollywood songs).
YOUTUBE_PLAYLIST_ID=PL7E6RBJ3R2ay6WkbHxhwhhNE2QiFvROpm

# --- Google OAuth (ONLY needed on your machine for the sync script,
#     NOT required at runtime / on the server) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Spotify (optional metadata enrichment: film + year for now-playing) ---
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
